# Copy this file to .env and fill in real local values.
# .env is gitignored — never commit real secrets.

# ---- PostgreSQL (used by the postgres container and the api service) ----
POSTGRES_USER=unihub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=unihub

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=unihub
MINIO_ROOT_PASSWORD=changeme123

# ---- Frontend ----
# Must be a browser-reachable URL, not the internal docker-network hostname.
VITE_API_URL=http://localhost:8080

# ---- Backend ----
# "dev" enables verbose logging + localhost CORS (see application-dev.yml).
# Use "prod" (with FRONTEND_URL set) for a production-like deploy.
SPRING_PROFILES_ACTIVE=dev

# ---- JWT signing ----
# HMAC-SHA256 signing secret. MUST be at least 32 characters (256 bits) or the
# app refuses to start. Generate a strong random value for real deployments.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# ---- Seed accounts ----
# On first boot the backend creates these accounts if they don't already exist.
# Any account whose env vars are incomplete is skipped (a warning is logged).
ADMIN_EMAIL=admin@unihub.local
ADMIN_PASSWORD=changeme-admin
ADMIN_FULL_NAME=UniHub Admin

TEACHER_EMAIL=teacher@unihub.local
TEACHER_PASSWORD=changeme-teacher
TEACHER_FULL_NAME=Alice Martin

STUDENT_EMAIL=student@unihub.local
STUDENT_PASSWORD=changeme-student
STUDENT_FULL_NAME=Bob Dupont

# Override the seed class group name (default: "L3 Info A")
# SEED_CLASS_GROUP=L3 Info A
