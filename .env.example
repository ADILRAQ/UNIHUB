# Copy this file to .env and fill in real local values.
# .env is gitignored — never commit real secrets.

# ---- PostgreSQL (used by the postgres container and the api service) ----
POSTGRES_USER=unihub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=unihub

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=unihub
MINIO_ROOT_PASSWORD=changeme123

# ---- Frontend ----
# Must be a browser-reachable URL, not the internal docker-network hostname.
VITE_API_URL=http://localhost:8080

# ---- Backend ----
# "dev" enables verbose logging + localhost CORS (see application-dev.yml).
# Use "prod" (with FRONTEND_URL set) for a production-like deploy.
SPRING_PROFILES_ACTIVE=dev
